{
  "name": "bloom-english",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build && node scripts/build-server.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "dev:worker": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply bloom-accounts --local",
    "db:generate": "drizzle-kit generate",
    "dev:ui": "vite --host 0.0.0.0",
    "test:accounts": "node --test tests/accounts-integration.mjs",
    "test:feedback": "node --test tests/feedback-integration.mjs",
    "test:ui": "node --test tests/ui-render.mjs",
    "test:curriculum": "node --test tests/curriculum.mjs",
    "test:calendar": "node --test tests/calendar.mjs",
    "test:static": "npm run build && node --test tests/static-routing.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "vite": "^6.0.0",
    "wrangler": "^4.161.0"
  }
}
